# Instância ServiceNow — apenas a origem, sem barra no final
SN_INSTANCE_URL=https://suainstancia.service-now.com

# Autenticação. Use um usuário DEDICADO de integração com a role snc_read_only.
# Nunca use uma conta de admin pessoal aqui.
SN_AUTH_TYPE=basic
SN_USERNAME=
SN_PASSWORD=

# Opcional — OAuth2 client credentials (SN_AUTH_TYPE=oauth)
# SN_CLIENT_ID=
# SN_CLIENT_SECRET=

# Ajustes de execução
SN_PAGE_SIZE=200
SN_TIMEOUT_MS=60000
SN_MAX_RETRIES=4
